{
  "name": "pi-claude-sdk-provider-experiment",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test bridge.test.mjs",
    "test:correlation": "node correlation.mjs",
    "test:live": "node --experimental-strip-types live.mjs",
    "test:common": "node --experimental-strip-types common.mjs",
    "test:remote": "node remote.mjs",
    "test:steering": "node steering.mjs",
    "test:reconnect": "node reconnect.mjs",
    "test:handoff": "node handoff.mjs",
    "test:progress": "node progress.mjs",
    "test:recovery": "node recovery.mjs",
    "test:malformed": "node malformed.mjs",
    "test:cancel": "node cancel.mjs",
    "test:tools": "node tools.mjs",
    "test:subagents": "node subagents.mjs",
    "test:notices": "node notices.mjs",
    "test:compaction": "node compaction-context.mjs",
    "test:clone": "node clone.mjs",
    "test:fork": "node fork.mjs",
    "test:tree": "node tree.mjs",
    "experiment:compact-sdk": "node --experimental-strip-types compaction.mjs",
    "experiment:compact-pi": "node --experimental-strip-types compaction-pi.mjs"
  },
  "pi": { "extensions": ["./index.ts"] },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "typebox": "^1.3.27"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "22.15.30",
    "typebox": "1.3.27",
    "typescript": "5.8.3"
  }
}
